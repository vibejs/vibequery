{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleDetection": "force",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@vibecn/*": ["./src/components/ui/*"]
    }
  },
  "contentMappers": [{ "package": "@usevibejs/language-tools", "extensions": [".vibe"] }],
  "include": ["src"]
}
